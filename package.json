{
  "name": "js-tetris",
  "version": "1.0.0",
  "private": true,
  "description": "Development checks for the dependency-free browser Tetris game",
  "scripts": {
    "test": "node --test test/engine.test.js test/review-canary.test.js",
    "test:browser": "PLAYWRIGHT_BROWSERS_PATH=0 playwright test",
    "lint": "standard \"js/**/*.js\" \"review-canary/**/*.js\" \"test/**/*.js\"",
    "format": "standard --fix \"js/**/*.js\" \"review-canary/**/*.js\" \"test/**/*.js\""
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "standard": "17.1.2"
  },
  "engines": {
    "node": ">=22 <23"
  }
}
